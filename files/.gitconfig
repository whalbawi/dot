[user]
	name = Wael Halbawi
[diff]
	tool = vimdiff
[alias]
	sl = log --date=short --format='%C(blue)%h  %C(yellow)%ad %<(20)%Cred%aN%Creset %<(80,trunc)%s'
	carn = commit --amend --no-edit --reset-author
	pof = push origin -f
	su = "!f() { git push origin --set-upstream $(git branch --show-current); }; f"
[merge]
	tool = opendiff
[difftool]
	prompt = true
[mergetool]
	prompt = false
[pull]
	rebase = true
